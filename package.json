{
  "name": "pauseai-es-presentaciones",
  "type": "module",
  "private": true,
  "version": "1.0.0",
  "description": "Coleccion de presentaciones PauseAI España",
  "scripts": {
    "dev": "turbo run dev dev:en",
    "build": "turbo run build build:en",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "prepare": "[ \"$PACKAGED\" = true ] && echo 'Skipping prepare for packaged production dependencies install' || husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@slango.configs/eslint": "1.2.34",
    "@slango.configs/lint-staged": "1.1.30",
    "@slango.configs/prettier": "1.0.24",
    "eslint": "10.7.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.5",
    "turbo": "2.10.5"
  },
  "engines": {
    "node": "^26.5.0",
    "pnpm": "^11.15.0"
  },
  "packageManager": "pnpm@11.15.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.15.0",
      "onFail": "download"
    }
  }
}
